{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": true,
  "default_agent": "plan",

  // === Permissions ===
  "permission": {
    "bash": {
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      ":(){:|:&};:": "deny" // fork bomb, just in case
    }
  },

  // === Agent Overrides ===
  "agent": {
    "plan": {
      "model": "opencode-go/minimax-m3"
    },
    "build": {
      "model": "opencode-go/minimax-m3",
      "permission": {
        "bash": "ask"
      }
    }
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser=chrome",
        "--user-data-dir=./.chrome-agent-profile",
        "--output-dir=./.playwright-mcp/screenshots"
      ],
      "enabled": true
    },
    "figma-console": {
      "type": "local",
      "command": ["npx", "-y", "figma-console-mcp@latest"],
      "enabled": true
    }
  },

  // === Experimental ===
  "experimental": {
    "disable_paste_summary": true
  }
}