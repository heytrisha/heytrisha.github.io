---
// src/components/case-studies/FlowScrollButton.astro
// Arrow button that scrolls a horizontal stepper strip to its end without moving the page.
// The anchor href is a no-JS fallback; the script intercepts the click and scrolls only the target strip.

interface Properties {
  targetId: string;
  fallbackId: string;
  label: string;
}

const { targetId, fallbackId, label } = Astro.props as Properties;
---

<a
  href={`#${fallbackId}`}
  data-scroll-target={targetId}
  aria-label={label}
  class="border-foreground/15 text-foreground/70 hover:text-foreground flex h-8 w-8 items-center justify-center rounded-full border transition-colors hover:bg-white/10"
>
  →
</a>

<script>
  document.querySelectorAll('[data-scroll-target]').forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      const track = document.getElementById(button.getAttribute('data-scroll-target') ?? '');
      if (!track) return;
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: track.scrollWidth, behavior: smooth ? 'smooth' : 'auto' });
    });
  });
</script>
