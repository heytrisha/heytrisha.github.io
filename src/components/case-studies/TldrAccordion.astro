---
// src/components/case-studies/TldrAccordion.astro
// Inline TL;DR expander rendered below the case-study header. Native
// <details> element, so no client JavaScript is needed. Points starting
// with '## ' render as section headings; **bold** markers render bold.

interface Properties {
  points: string[];
}

const { points } = Astro.props as Properties;

function renderParts(text: string) {
  return text.split('**');
}
---

{
  points.length > 0 && (
    <details class="border-foreground/10 bg-card group rounded-xl border">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-base font-semibold tracking-tight [&::-webkit-details-marker]:hidden">
        <span>
          TL;DR <span class="text-muted-foreground font-normal">— the 30-second version</span>
        </span>
        <span
          aria-hidden="true"
          class="text-muted-foreground transition-transform duration-200 group-open:rotate-180"
        >
          ↓
        </span>
      </summary>
      <ul class="space-y-3 px-5 pb-5">
        {points.map((point) =>
          point.startsWith('## ') ? (
            <li class="pt-2 text-sm font-semibold text-[#fafafa]">{point.slice(3)}</li>
          ) : (
            <li class="flex gap-3 text-sm leading-relaxed">
              <span
                aria-hidden="true"
                class="mt-2 size-1.5 shrink-0 rounded-full bg-[color:var(--case-accent)]"
              />
              <span class="text-foreground/80">
                {renderParts(point).map((part, index) =>
                  index % 2 === 1 ? (
                    <strong class="font-semibold text-[#fafafa]">{part}</strong>
                  ) : (
                    part
                  ),
                )}
              </span>
            </li>
          ),
        )}
      </ul>
    </details>
  )
}
