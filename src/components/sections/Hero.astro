---
import { Image } from 'astro:assets';
import { site } from '@/data/site';
import portrait from '@/assets/images/intro/intro.png';
---

<section class="flex min-h-[calc(100svh-4rem)] flex-col justify-center px-6 py-10">
  <div
    class="mx-auto grid w-full max-w-6xl items-center gap-6 lg:-translate-x-6 lg:grid-cols-[1.35fr_0.8fr] lg:gap-14"
  >
    <div class="text-left lg:order-2">
      <h1
        class="mt-4 text-[1.75rem] font-bold tracking-tight whitespace-nowrap sm:text-4xl lg:text-5xl xl:text-6xl"
      >
        Hi, I&apos;m {site.fullName}
      </h1>
      <p class="text-muted-foreground mt-6 max-w-xl text-lg leading-relaxed sm:text-xl">
        I am a self-taught Product Designer. My design workflow includes research, wireframing, vibe
        coding, fast prototyping, while leveraging AI. I build design systems to keep what I make
        consistent as it grows.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="#work" class="cta-primary">View my work</a>
        <a href="#connect" class="cta-secondary">Get in touch</a>
      </div>
    </div>
    <div class="flex w-full justify-center md:justify-start lg:order-1 lg:justify-start">
      <Image
        src={portrait}
        alt={`Portrait of ${site.fullName}`}
        class="h-auto max-h-[calc(100svh-12rem)] w-auto mix-blend-screen"
        loading="eager"
      />
    </div>
  </div>
</section>
