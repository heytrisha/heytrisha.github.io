---
import { site } from '@/data/site';
---

<section class="flex min-h-[calc(100vh-4rem)] flex-col items-center justify-center px-6 py-20 text-center">
  <div class="relative mx-auto max-w-3xl">
    <p class="text-sm font-medium tracking-widest text-muted-foreground uppercase">
      {site.title}
    </p>
    <h1 class="mt-4 text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
      {site.fullName}
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-muted-foreground sm:text-xl">
      Seven years in aviation gave me a front-row seat to human behavior. Now designing full-time, I craft intuitive products that turn everyday digital interactions into unique, delightful experiences.
    </p>
    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a href="#work" class="cta-primary">View my work</a>
      <a href="#connect" class="cta-secondary">Get in touch</a>
    </div>
  </div>
</section>
